# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Monitor no navegador (polling)
# Padrão: 10000ms (10s). Use >= 3000ms.
NEXT_PUBLIC_MONITOR_POLL_INTERVAL_MS=10000

# Se quiser que a coleta de disponibilidade dependa SOMENTE do cron (Supabase/HTTP),
# desligue o log de disponibilidade feito pelo app:
NEXT_PUBLIC_AVAILABILITY_LOG_ENABLED=1

# Política esparsa de logs (opcional)
# Se definido, força persistir online quando RT estiver fora da faixa.
#
# Ex.: minResponseMs=200 e maxResponseMs=400
# - grava online quando RT < minResponseMs (degradação)
# - grava online quando RT > maxResponseMs (degradação)
#
# AVAILABILITY_LOG_MIN_RESPONSE_MS=
# AVAILABILITY_LOG_MAX_RESPONSE_MS=

# Configuração da confiança do SLA / cobertura de observação (opcional)
# Em caso de “staleness” (gap sem execução suficiente), a confiança degrada linearmente.
# Default: grace=5min, decayToZero=15min.
#
# AVAILABILITY_OBSERVATION_GRACE_MS=300000
# AVAILABILITY_OBSERVATION_DECAY_TO_ZERO_MS=900000

# Cron endpoint (se for chamar via HTTP)
# Deve ser o mesmo que você configurar no scheduler (ex.: Vercel Cron ou equivalente).
#
# CRON_SECRET=

# Logs de debug (opcional)
# MONITOR_DEBUG_LOGS=1
